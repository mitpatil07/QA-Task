<?xml version="1.0" encoding="UTF-8"?>
<!--
    testng.xml — TestNG Suite Configuration
    ========================================
    This file controls WHICH tests run, in WHAT ORDER, and with WHAT settings.
    Surefire plugin in pom.xml points at this file so `mvn test` reads it automatically.

    To run only a specific test class:
        mvn test -Dtest=LoginTest

    To run the full suite as configured here:
        mvn test
-->
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="FieldForceConnect Test Suite" verbose="2">

    <!--
        verbose="2" gives detailed console output showing each test method result.
        Higher values (up to 10) give more detail; use 1 for minimal output.
    -->

    <!-- ===================================================
         Test Group 1 — Login Data-Driven Tests
         Runs LoginTest with 5 credential sets (3 valid + 2 invalid)
         =================================================== -->
    <test name="Login Tests">
        <classes>
            <class name="tests.LoginTest"/>
        </classes>
    </test>

    <!-- ===================================================
         Test Group 2 — Punch-In Toast Verification
         Logs in, navigates to Attendance, clicks Punch-In,
         asserts toast message, and saves screenshot evidence.
         =================================================== -->
    <test name="Punch-In Tests">
        <classes>
            <class name="tests.PunchInTest"/>
        </classes>
    </test>

    <!-- ===================================================
         Test Group 3 — Add Customer Data-Driven Tests
         Logs in, fills Add Customer form for each CSV row,
         and validates the customer appears in the list.
         =================================================== -->
    <test name="Add Customer Tests">
        <classes>
            <class name="tests.AddCustomerTest"/>
        </classes>
    </test>

</suite>
